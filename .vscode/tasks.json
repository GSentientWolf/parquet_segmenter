{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pytest",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m pytest __tests__/unit -q",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "pylint",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m pylint src",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "mypy",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m mypy src",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
